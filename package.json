  "type": "module",
  "workspaces": [
    "./vscode",
    "./examples/*"
  ],
  "files": [
    "lib"
  ],
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "lib/server.js"
      ],
      "compilerOptions": [
        "allowJs",
        "jsxImportSource"
      ],
      "dynamicConfig": false
    }
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "../typescript-go/built/local/tsgo --build fixtures --runExternalCode"
  },
  "dependencies": {
