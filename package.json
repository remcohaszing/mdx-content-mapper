    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx": "^3.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "vfile-message": "^4.0.0",
    "toml": "^5.0.0",
    "vscode-jsonrpc": "^9.0.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@remcohaszing/eslint": "^14.0.0",
    "@types/estree-jsx": "^1.0.0",
    "@types/mdast": "^4.0.0",
    "@types/node": "^26.0.0",
