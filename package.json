    "remark-cli": "^12.0.0",
    "remark-preset-remcohaszing": "^3.0.0",
    "snapshot-fixtures": "^1.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript7": "npm:typescript@next"
  }
}
