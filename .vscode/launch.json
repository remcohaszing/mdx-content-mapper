{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "autoAttachChildProcesses": true,
      "args": [
        "--disable-updates",
        "--disable-workspace-trust",
        "--profile-temp",
        "--skip-release-notes",
        "--skip-welcome",
        "--extensionDevelopmentPath=${workspaceFolder}/vscode",
        "${workspaceFolder}/fixtures.code-workspace"
      ],
      "env": {
        "NODE_OPTIONS": "--enable-source-maps"
      },
      "outFiles": ["${workspaceFolder}/vscode/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**", "**/typescript/**"],
      "preLaunchTask": "build"
    }
  ]
}
